+    ) -> (TracingInspector, Result<(), String>) {
+        // PUSH1 1 (depth times); JUMPDEST; PUSH1 <jumpdest>; JUMP
+        let mut code = Vec::new();
+        for _ in 0..depth {
+            code.extend([0x60, 0x01]);
+        }
