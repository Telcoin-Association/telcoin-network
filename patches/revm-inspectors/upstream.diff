+    /// revm's `EVMError::Custom`, and the halted interpreter cannot carry on past a pending
+    /// action.
+    #[inline]
+    fn record_bytes<CTX: ContextTr>(
+        &self,
+        interp: &mut Interpreter,
+        context: &mut CTX,
